<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alex.finance.finance.mapper.FinanceBudgetInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.alex.finance.finance.entity.FinanceBudgetInfo">
        <result column="id" property="id" />
        <result column="is_delete" property="isDelete" />
        <result column="creator" property="creator" />
        <result column="updater" property="updater" />
        <result column="deleter" property="deleter" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="delete_time" property="deleteTime" />
        <result column="operate_time" property="operateTime" />
        <result column="org_id" property="orgId" />
        <result column="belong_to" property="belongTo" />
        <result column="budget_month" property="budgetMonth" />
        <result column="income_and_expenses" property="incomeAndExpenses" />
        <result column="budget_amount" property="budgetAmount" />
        <result column="category_codes" property="categoryCodes" />
        <result column="is_valid" property="isValid" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, is_delete, creator, updater, deleter, create_time, update_time, delete_time, operate_time,
        org_id, belong_to, budget_month, income_and_expenses, budget_amount, category_codes, is_valid
    </sql>

    <!-- 查询指定月份配置 (按家庭组机构) -->
    <select id="selectByMonth" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM finance_budget_info
        WHERE org_id = #{orgId}
          AND budget_month = #{budgetMonth}
          AND (is_delete = '0' OR is_delete = 0)
        LIMIT 1
    </select>

    <!-- 查询指定月份之前的最近一条历史配置 (继承基准，按家庭组机构) -->
    <select id="selectLatestBefore" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM finance_budget_info
        WHERE org_id = #{orgId}
          AND budget_month &lt; #{budgetMonth}
          AND (is_delete = '0' OR is_delete = 0)
        ORDER BY budget_month DESC
        LIMIT 1
    </select>

</mapper>
