<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alex.finance.contactsUser.mapper.ContactsUserMapper">

	<!-- 开启二级缓存 -->
	<cache/>

	<!-- 通用结果映射 -->
	<resultMap id="BaseResultMap" type="com.alex.finance.contactsUser.entity.ContactsUser">
		<id column="id" property="id"/>
		<result column="name" property="name"/>
		<result column="phone" property="phone"/>
		<result column="relationship" property="relationship"/>
		<result column="email" property="email"/>
		<result column="address" property="address"/>
		<result column="remarks" property="remarks"/>
		<result column="is_favorite" property="isFavorite"/>
		<result column="creator" property="creator"/>
		<result column="create_time" property="createTime"/>
		<result column="updater" property="updater"/>
		<result column="update_time" property="updateTime"/>
		<result column="operator" property="operator"/>
		<result column="operate_time" property="operateTime"/>
		<result column="deleter" property="deleter"/>
		<result column="delete_time" property="deleteTime"/>
		<result column="is_delete" property="isDelete"/>
	</resultMap>

	<!-- VO结果映射 -->
	<resultMap id="VoResultMap" type="com.alex.api.finance.contactsUser.vo.ContactsUserVo">
		<id column="id" property="id"/>
		<result column="name" property="name"/>
		<result column="phone" property="phone"/>
		<result column="relationship" property="relationship"/>
		<result column="email" property="email"/>
		<result column="address" property="address"/>
		<result column="remarks" property="remarks"/>
		<result column="is_favorite" property="isFavorite"/>
		<result column="create_time" property="createTime"/>
		<result column="update_time" property="updateTime"/>
	</resultMap>

	<!-- 通用查询列 -->
	<sql id="Base_Column_List">
		id, name, phone, relationship, email, `address`, remarks, is_favorite, creator, create_time, updater, update_time, operator, operate_time, deleter, delete_time, is_delete
	</sql>

	<!-- 查询Vo列 -->
	<sql id="Vo_Column_List">
		id, name, phone, relationship, email, `address`, remarks, is_favorite, create_time, update_time
	</sql>

	<!-- 查询分页列表 -->
	<select id="getPage" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM t_contacts_user
		WHERE is_delete = 0
		<if test="contactsUserVo.name != null and contactsUserVo.name != ''">
			AND name LIKE CONCAT('%', #{contactsUserVo.name}, '%')
		</if>
		<if test="contactsUserVo.phone != null and contactsUserVo.phone != ''">
			AND phone LIKE CONCAT('%', #{contactsUserVo.phone}, '%')
		</if>
		<if test="contactsUserVo.relationship != null and contactsUserVo.relationship != ''">
			AND relationship = #{contactsUserVo.relationship}
		</if>
		<if test="contactsUserVo.isFavorite != null">
			AND is_favorite = #{contactsUserVo.isFavorite}
		</if>
		<if test="contactsUserVo.keyword != null and contactsUserVo.keyword != ''">
			AND (name LIKE CONCAT('%', #{contactsUserVo.keyword}, '%') OR phone LIKE CONCAT('%', #{contactsUserVo.keyword}, '%'))
		</if>
		ORDER BY operate_time DESC
	</select>

	<!-- 查询详情 -->
	<select id="queryContactsUser" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM t_contacts_user
		WHERE id = #{id} AND is_delete = 0
	</select>

	<!-- 查询重复的名称和电话 -->
	<select id="checkDuplicate" resultType="com.alex.api.finance.contactsUser.vo.CheckContactsVo">
		SELECT
			(SELECT COUNT(1) FROM t_contacts_user WHERE name = #{name}
				<if test="excludeId != null">
					AND id != #{excludeId}
				</if>
				AND is_delete = 0) AS name_count,
			(SELECT COUNT(1) FROM t_contacts_user WHERE phone = #{phone}
				<if test="excludeId != null">
					AND id != #{excludeId}
				</if>
				AND is_delete = 0) AS phone_count
	</select>

</mapper>
