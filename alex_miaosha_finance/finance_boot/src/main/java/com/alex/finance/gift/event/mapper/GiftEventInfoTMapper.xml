<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alex.finance.gift.event.mapper.GiftEventInfoTMapper">

    <sql id="queryConditions">
        <if test="query != null">
            <if test="query.keyword != null and query.keyword != ''">
                AND e.event_name LIKE CONCAT('%', #{query.keyword}, '%')
            </if>
            <if test="query.eventType != null and query.eventType != ''">
                AND e.event_type = #{query.eventType}
            </if>
            <if test="query.eventTimeStart != null">
                AND e.event_time &gt;= #{query.eventTimeStart}
            </if>
            <if test="query.eventTimeEnd != null">
                AND e.event_time &lt;= #{query.eventTimeEnd}
            </if>
        </if>
    </sql>

    <sql id="voColumns">
        e.id,
        e.org_id,
        e.user_id,
        e.event_name,
        e.event_type,
        e.event_time,
        e.host_person_id,
        e.remark,
        e.create_time,
        e.update_time
    </sql>

    <select id="getPage" resultType="com.alex.api.finance.gift.event.vo.GiftEventInfoTVo">
        SELECT <include refid="voColumns"/>
        FROM gift_event_info_t e
        <where>
            <include refid="queryConditions"/>
        </where>
        ORDER BY e.event_time DESC
    </select>

    <select id="getList" resultType="com.alex.api.finance.gift.event.vo.GiftEventInfoTVo">
        SELECT <include refid="voColumns"/>
        FROM gift_event_info_t e
        <where>
            <include refid="queryConditions"/>
        </where>
        ORDER BY e.event_time DESC
    </select>

    <select id="listEntities" resultType="com.alex.finance.gift.event.entity.GiftEventInfoT">
        SELECT <include refid="voColumns"/>
        FROM gift_event_info_t e
        <where>
            <include refid="queryConditions"/>
        </where>
        ORDER BY e.event_time DESC
    </select>

</mapper>
