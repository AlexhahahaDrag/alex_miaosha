<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alex.finance.contactsUserRelation.mapper.ContactsUserRelationMapper">

	<!-- 通用结果映射 -->
	<resultMap id="BaseResultMap" type="com.alex.finance.contactsUserRelation.entity.ContactsUserRelation">
		<id column="id" property="id"/>
		<result column="user_id" property="userId"/>
		<result column="relationship_tag" property="relationshipTag"/>
		<result column="importance" property="importance"/>
		<result column="description" property="description"/>
		<result column="remarks" property="remarks"/>
		<result column="is_enabled" property="isEnabled"/>
		<result column="creator" property="creator"/>
		<result column="create_time" property="createTime"/>
		<result column="updater" property="updater"/>
		<result column="update_time" property="updateTime"/>
		<result column="operator" property="operator"/>
		<result column="operate_time" property="operateTime"/>
		<result column="deleter" property="deleter"/>
		<result column="delete_time" property="deleteTime"/>
		<result column="is_delete" property="isDelete"/>
	</resultMap>

	<!-- VO结果映射 -->
	<resultMap id="VoResultMap" type="com.alex.api.finance.contactsUserRelation.vo.ContactsUserRelationVo">
		<id column="id" property="id"/>
		<result column="user_id" property="userId"/>
		<result column="relationship_tag" property="relationshipTag"/>
		<result column="importance" property="importance"/>
		<result column="description" property="description"/>
		<result column="remarks" property="remarks"/>
		<result column="is_enabled" property="isEnabled"/>
		<result column="create_time" property="createTime"/>
		<result column="update_time" property="updateTime"/>
	</resultMap>

	<!-- 通用查询列 -->
	<sql id="Base_Column_List">
		id, user_id, relationship_tag, importance, description, remarks, is_enabled,
		creator, create_time, updater, update_time,
		operator, operate_time, deleter, delete_time, is_delete
	</sql>

	<!-- 查询Vo列 -->
	<sql id="Vo_Column_List">
		id, user_id, relationship_tag, importance, description, remarks, is_enabled,
		create_time, update_time
	</sql>

	<!-- 查询分页列表 -->
	<select id="getPage" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM contacts_user_relation_info_t
		WHERE is_delete = 0
		<if test="'super_super' != roleCode">
			and (user_id in (<include refid="com.alex.finance.common.mapper.CommonMapper.familyGroup"/>)
				or user_id is null
			)
		</if>
		<if test="vo.relationshipTag != null and vo.relationshipTag != ''">
			AND relationship_tag LIKE CONCAT('%', #{vo.relationshipTag}, '%')
		</if>
		<if test="vo.importance != null">
			AND importance = #{vo.importance}
		</if>
		<if test="vo.isEnabled != null">
			AND is_enabled = #{vo.isEnabled}
		</if>
		<if test="vo.keyword != null and vo.keyword != ''">
			AND (relationship_tag LIKE CONCAT('%', #{vo.keyword}, '%') OR description LIKE CONCAT('%', #{vo.keyword}, '%') OR remarks LIKE CONCAT('%', #{vo.keyword}, '%'))
		</if>
		ORDER BY operate_time DESC
	</select>

	<!-- 查询详情 -->
	<select id="queryContactsUserRelation" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM contacts_user_relation_info_t
		WHERE id = #{id} AND is_delete = 0
	</select>

	<!-- 根据关系标签查询 -->
	<select id="queryByRelationshipTag" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM contacts_user_relation_info_t
		WHERE relationship_tag = #{relationshipTag} AND is_delete = 0 AND is_enabled = 1
	</select>

	<!-- 查询所有启用的公共关系分类 -->
	<select id="queryEnabledPublicRelations" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM contacts_user_relation_info_t
		WHERE is_delete = 0 AND is_enabled = 1 AND user_id IS NULL
		ORDER BY importance DESC, operate_time DESC
	</select>

	<!-- 查询用户的所有启用的关系分类（公共+私有） -->
	<select id="queryEnabledRelationsByUser" resultMap="VoResultMap">
		SELECT
		<include refid="Vo_Column_List"/>
		FROM contacts_user_relation_info_t
		WHERE is_delete = 0 AND is_enabled = 1
		<if test="'super_super' != roleCode">
			and (user_id in (<include refid="com.alex.finance.common.mapper.CommonMapper.familyGroup"/>)
				or user_id is null
			)
		</if>
		ORDER BY importance DESC, operate_time DESC
	</select>

</mapper>