<%
    var hasDate = false;
    for(field in table.fields){
        if(field.propertyType == 'LocalDateTime' || field.propertyType == 'Date'){
           hasDate = true;
        }
    }
    var hasDict = false;
    var dictType = '';
    for(field in table.fields){
        if(strutil.contain(field.comment, '字典')){
           hasDict = true;
           dictType += strutil.subStringTo(field.comment, strutil.index(field.comment, '字典(') + 3, strutil.index(field.comment, ')')) + ",";
        }
    }
    if (strutil.length(dictType) > 1) {
        dictType = strutil.subStringTo(dictType, 0, strutil.length(dictType) - 1);
    }
%>
<template>
	<div class="page-info">
		<div class="search">
			<div class="search-box">
				<a-form
					:model="searchInfo"
					:label-col="labelCol"
					:wrapper-col="wrapperCol"
				>
<% var pre = 0; %>
<% var num = 0; %>
<% var id = "id"; %>
<% for(field in table.fields){
       if(field.keyFlag) {
            id = field.propertyName;
            continue;
       }
       if(num % 3 == 0){ %>
					<a-row :gutter="24">
  <% } %>
    <% num++; %>
            <a-col :span="8">
              <a-form-item
                :name="labelMap['${field.propertyName}'].name"
                :label="labelMap['${field.propertyName}'].label"
              >
    <% if (strutil.contain(field.comment, '字典')) { %>
                <a-select ref="select" v-model:value="searchInfo.${field.propertyName}" :placeholder="'请选择' + labelMap['${field.propertyName}'].label"
                  :field-names="{ label: 'typeName', value: 'typeCode' }" :options="${field.propertyName}List" :allowClear="true">
                </a-select>
    <% } else { %>
                <a-input
                    v-model:value="searchInfo.${field.propertyName}"
                    :placeholder="'请输入' + labelMap['${field.propertyName}'].label"
                    allow-clear
                />
    <% } %>
              </a-form-item>
            </a-col>
  <% if(num % 3 == 0){ %>
          </a-row>
  <% } %>
<% } %>
  <% if(num % 3 != 0){ %>
          </a-row>
  <% } %>
            <a-row :gutter="24">
                <a-col :span="20" style="text-align: right; margin-bottom: 20px">
                  <a-space>
                    <a-button type="primary" @click="query"> 查找</a-button>
                    <a-button type="primary" @click="cancelQuery">清空</a-button>
                  </a-space>
                </a-col>
            </a-row>
        </a-form>
      </div>
    </div>
		<div class="button" style="margin-left: 10px;">
			<a-space>
				<a-button type="primary" @click="edit${entity}('add')">新增</a-button>
				<a-button type="primary" danger @click="batchDel${entity}">
					删除
				</a-button>
			</a-space>
		</div>
		<div class="content">
			<a-table
				:dataSource="dataSource"
				:columns="columns"
				:loading="loading"
				:row-key="(record: ${entity}Data) => record.${id} || 0"
				:pagination="pagination"
				@change="handleTableChange"
				:scroll="{ x: 'max-content' }"
				:row-selection="rowSelection"
			>
				<template #bodyCell="{ column, record }">
					<template v-if="column.key === 'operation'">
                        <a-space>
							<a-button
								type="primary"
								size="small"
								@click="edit${entity}('update', record.${id})"
							>
								编辑
							</a-button>
							<a-popconfirm
								title="确认删除?"
								ok-text="确认"
								cancel-text="取消"
								@confirm="del${entity}(record.${id})"
								@cancel="cancel"
							>
								<a-button type="primary" size="small" danger>删除</a-button>
							</a-popconfirm>
						</a-space>
					</template>
				</template>
			</a-table>
			<${entity}Detail
				ref="editInfo"
				:open="visible"
				:modelInfo="modelInfo"
				@handleOk="handleOk"
				@handleCancel="handleCancel"
			>
			</${entity}Detail>
		</div>
	</div>
</template>
<script setup lang="ts">
import { message } from 'ant-design-vue';
import { get${entity}Page, delete${entity} } from './api';
import type { ModelInfo } from '@/views/common/config';
import type { ${entity}Data } from './config';
import { columns, labelMap, labelCol, wrapperCol } from './config';
<% if(hasDict){ %>
import { useDictInfo } from '@/composables/useDictInfo';
<% } %>
import { usePagination, type PageInfo } from '@/composables/usePagination';
<% if (hasDict) { %>

<% } %>
<% if (hasDict) {
    var dict = '';
    for(field in table.fields){
        if(field.keyFlag) {
             continue;
        }
        if (strutil.contain(field.comment, '字典')) { %>
        dict += ${field.propertyName} + ',';
    } %>
const { getDictByType } = useDictInfo('${dict}');
<% } %>
<% if (hasDict) { %>

<% } %>
<% if (hasDict) { %>
    for(field in table.fields){
        if(field.keyFlag) {
             continue;
        }
        if (strutil.contain(field.comment, '字典')) { %>
const ${field.propertyName}List = computed(() => getDictByType('${field.propertyName}'));
        <% }
    }
} %>

// 使用分页组合式函数
const {
	pagination,
	handleTableChange: paginationChange,
	setTotal,
} = usePagination();

let loading = ref<boolean>(false);

let dataSource = ref<${entity}Data[]>([]);

let visible = ref<boolean>(false);

let modelInfo = ref<ModelInfo>({});

let rowIds: (string | number)[] = [];

let searchInfo = ref<${entity}Data>({});

const rowSelection = ref({
	checkStrictly: false,
	onChange: (
		selectedRowKeys: (string | number)[],
		_selectedRows: ${entity}Data[],
	) => {
		console.log(_selectedRows);
		rowIds = selectedRowKeys;
	},
	onSelect: (
		record: ${entity}Data,
		selected: boolean,
		selectedRows: ${entity}Data[],
	) => {
		console.log(record, selected, selectedRows);
	},
	onSelectAll: (
		selected: boolean,
		selectedRows: ${entity}Data[],
		changeRows: ${entity}Data[],
	) => {
		console.log(selected, selectedRows, changeRows);
	},
});

const cancelQuery = (): void => {
	searchInfo.value = {};
};

const query = (): void => {
	get${entity}ListPage(searchInfo.value, pagination);
};

const handleTableChange = (paginationInfo: PageInfo): void => {
	paginationChange(paginationInfo);
	get${entity}ListPage(searchInfo.value, pagination);
};

const del${entity} = async (ids: string) => {
	const { code, message: messageInfo } = await delete${entity}(ids);
	if (code == '200') {
		message.success(messageInfo || '删除成功！', 3);
		get${entity}ListPage(searchInfo.value, pagination);
	} else {
		message.error(messageInfo || '删除失败！', 3);
	}
};

const batchDel${entity} = (): void => {
	if (!rowIds?.length) {
		message.warning('请先选择数据！', 3);
		return;
	}
	del${entity}(rowIds.join(','));
};

const cancel = (e: MouseEvent): void => {
	console.log(e);
};

const get${entity}ListPage = async (
	param: ${entity}Data,
	cur: PageInfo,
) => {
	loading.value = true;
	const {
		code,
		data,
		message: messageInfo,
	} = await get${entity}Page(param, cur.current, cur.pageSize).finally(() => {
			loading.value = false;
		});
	if (code == '200') {
		let curData = data;
		dataSource.value = curData?.records || [];
		pagination.current = curData?.current || 1;
		pagination.pageSize = curData?.size || 10;
		setTotal(curData?.total || 0);
	} else {
		message.error(messageInfo || '查询列表失败！');
	}
};

//新增和修改弹窗
const edit${entity} = (type: string, id?: number): void => {
	if (type == 'add') {
		modelInfo.value.title = '新增明细';
		modelInfo.value.id = undefined;
	} else if (type == 'update') {
		modelInfo.value.title = '修改明细';
		modelInfo.value.id = id;
	}
	modelInfo.value.confirmLoading = true;
	visible.value = true;
};

const handleOk = (v: boolean): void => {
	visible.value = v;
	get${entity}ListPage(searchInfo.value, pagination);
};

const handleCancel = (v: boolean): void => {
	visible.value = v;
};

const init = (): void => {
	//获取${table.comment!}页面数据
	get${entity}ListPage(searchInfo.value, pagination);
};

init();
</script>
<style lang="scss" scoped></style>
