<%
    var hasDate = false;
    for(field in table.fields){
        if(field.propertyType == 'LocalDateTime' || field.propertyType == 'Date'){
           hasDate = true;
        }
    }
    // 将实体名转换为 kebab-case（把大写转为 - 小写），用于前端目录
    // 例：CouponInfo -> coupon-info
    var entityCamel = strutil.toLowerCase(strutil.subStringTo(entity, 0, 1)) + strutil.subString(entity, 1);
    var entityKebab = "";
    // Beetl: for 循环变量需先声明，否则会出现 VAR_NOT_DEFINED
    var i = 0;
    for(; i < strutil.length(entityCamel); i++){
        var ch = strutil.subStringTo(entityCamel, i, i + 1);
        // 判断是否为大写字母：toUpperCase == 自己 且 toLowerCase != 自己
        if(ch == strutil.toUpperCase(ch) && ch != strutil.toLowerCase(ch)){
            entityKebab += "-" + strutil.toLowerCase(ch);
        } else {
            entityKebab += ch;
        }
    }
    if(strutil.length(entityKebab) > 0 && strutil.subStringTo(entityKebab, 0, 1) == "-"){
        entityKebab = strutil.subStringTo(entityKebab, 1, strutil.length(entityKebab));
    }
    var hasDict = false;
    var dictType = '';
    for(field in table.fields){
        if(strutil.contain(field.comment, '字典')){
           hasDict = true;
           dictType += strutil.subStringTo(field.comment, strutil.index(field.comment, '字典(') + 3, strutil.index(field.comment, ')')) + ",";
        }
    }
    if (strutil.length(dictType) > 1) {
        dictType = strutil.subStringTo(dictType, 0, strutil.length(dictType) - 1);
    }
%>
<template>
	<div>
		<a-modal
			:open="props.open"
			:width="props.modelInfo?.width || '1000px'"
			:title="props.modelInfo?.title || 'Basic Modal'"
			@ok="handleOk"
			okText="保存"
			:confirmLoading="loading"
			:destroyOnClose="true"
			@cancel="handleCancel"
		>
			<template #footer>
				<a-button key="back" @click="handleCancel">取消</a-button>
				<a-button
					key="submit"
					type="primary"
					:loading="loading"
					@click="handleOk"
				>
					保存
				</a-button>
			</template>
			<a-form
				ref="formRef"
				name="CouponInfoForm"
				class="ant-advanced-search-form"
				:model="formState"
				:rules="rulesRef"
				:label-col="labelCol"
				:wrapper-col="wrapperCol"
			>
<% var num = 0; %>
<% var pre = 0; %>
<% for(field in table.fields){
    if(field.keyFlag) {
        continue;
    }
  %>
  <% if(num % 2 == 0){ %>
        <a-row :gutter='24'>
  <% } %>
          <a-col :span='12'>
            <a-form-item
                :name="labelMap['${field.propertyName}'].name"
                :label="labelMap['${field.propertyName}'].label"
            >
              <% if (strutil.contain(field.comment, '字典')) { %>
              <a-select ref="select" v-model:value="formState.${field.propertyName}"
                :placeholder="'请选择' + labelMap['${field.propertyName}'].label"
                :field-names="{ label: 'typeName', value: 'typeCode' }"
                :options="${field.propertyName}List"
                :allowClear="true">
              </a-select>
              <% } else if (field.propertyType == 'LocalDateTime' || field.propertyType == 'Date') { %>
              <a-date-picker
                v-model:value="formState.${field.propertyName}"
                :format="'YYYY-MM-DD'"
                :getPopupContainer="(triggerNode: any) => { return triggerNode.parentNode }"
              />
              <% } else { %>
              <a-input
                v-model:value='formState.${field.propertyName}'
                :placeholder="'请填写' + labelMap['${field.propertyName}'].label"
              >
              </a-input>
              <% } %>
            </a-form-item>
          </a-col>
    <% num++; %>
  <% if(num % 2 == 0){ %>
        </a-row>
  <% } %>
<% } %>
<% if(num % 2 != 0){ %>
        </a-row>
<% } %>
      </a-form>
    </a-modal>
  </div>
</template>
<script lang='ts' setup>
import { message, type FormInstance } from 'ant-design-vue';
import type { ResponseBody } from '@/types/api';
import type { ModelInfo } from '@/views/common/config';
import type { ${entity}Data } from '../config';
import { labelMap } from '../config';
import { rulesRef, labelCol, wrapperCol } from './config';
import {
	get${entity}Detail,
	add${entity},
	edit${entity},
} from '@/views/${javaPath}/${entityKebab}/api';
<% if(hasDict) { %>
import { useDictInfo } from '@/composables/useDictInfo';
<% } %>
<% if (hasDict) { %>

<% } %>
<% if (hasDict) {
    var dict = '';
    for(field in table.fields){
        if(field.keyFlag) {
             continue;
        }
        if (strutil.contain(field.comment, '字典')) { %>
        dict += ${field.propertyName} + ',';
    } %>
const { getDictByType } = useDictInfo('${dict}');
<% } %>
<% if (hasDict) { %>

<% } %>
<% if (hasDict) { %>
    for(field in table.fields){
        if(field.keyFlag) {
             continue;
        }
        if (strutil.contain(field.comment, '字典')) { %>
const ${field.propertyName}List = computed(() => getDictByType('${field.propertyName}'));
        <% }
    }
} %>

let loading = ref<boolean>(false);

const formRef = ref<FormInstance>();

const modelConfig = {
	confirmLoading: true,
	destroyOnClose: true,
};

interface Props {
	open?: boolean;
	modelInfo?: ModelInfo;
}
const props = defineProps<Props>();

let formState = ref<${entity}Data>({});

const handleOk = () => {
	loading.value = true;
	if (formRef.value) {
		formRef.value
			.validateFields()
			.then(() => save${entity}())
			.catch(() => (loading.value = false));
	}
};
const handleCancel = () => {
	emit('handleCancel', false);
};

//保存${table.comment!}信息
const save${entity} = async () => {
	let api = add${entity};
	if (formState.value.id) {
		api = edit${entity};
	}
	loading.value = true;
	const { code, message: messageInfo } = await api(formState.value)
		.catch((error: ResponseBody) => {
			return error;
		})
		.finally(() => {
			loading.value = false;
		});
	if (code == '200') {
		message.success(messageInfo || '保存成功！');
		formState.value = {};
	} else {
		message.error(messageInfo || '保存失败！');
	}
};

const initDetail = async (modalData: ModelInfo | undefined) => {
	if (modalData?.id) {
		const {
			code,
			data,
			message: messageInfo,
		} = await get${entity}Detail(modalData.id);
		if (code == '200') {
			formState.value = data || {};
			modelConfig.confirmLoading = false;
		} else {
			message.error(messageInfo || '查询失败！');
		}
	} else {
		modelConfig.confirmLoading = false;
		formState.value = {};
	}
};

const init = async () => {
	//初始化数据
	initDetail(props.modelInfo);
};

const emit = defineEmits(['handleOk', 'handleCancel']);

defineExpose({ handleOk, handleCancel });

watch(
	() => props.open,
	(newVal) => {
		if (newVal) {
			init();
		}
	},
	{
		immediate: true,
		deep: true,
	},
);
</script>
<style lang='scss' scoped></style>
