import {
	getData,
	postData,
	putData,
	deleteData,
	baseService,
} from '@/utils/request';

import type { CommonPageResult, ResponseBody } from '@/types/api';

import type { ${entity}Data } from '../config';

// 基础URL配置
const base${entity} = '/api/v1<% if(isNotEmpty(package.ModuleName)){ %>/${package.ModuleName}<% } %>/<% if(isNotEmpty(controllerMappingHyphenStyle)){ %>${controllerMappingHyphen}<% }else{ %>${table.entityPath}<% } %>';

// API端点配置
const ${entity}Endpoints = {
	page: '/page',
	detail: '',
	delete: '',
	create: '',
	update: '',
};

/**
 * 获取${entity}分页数据
 * @param params 查询参数
 * @param pageNo 页码，默认为1
 * @param pageSize 每页大小，默认为10
 * @returns Promise<ApiResponse>
 */
export async function get${entity}Page(
	params: ${entity}Data,
	pageNo?: number | null,
	pageSize?: number | null,
): Promise<ResponseBody<CommonPageResult<${entity}Data>>> {
	const url = baseService.${javaPath} + base${entity} + ${entity}Endpoints.page;
	return postData(url, params, {
		pageNo: pageNo ? pageNo : 1,
		pageSize: pageSize ? pageSize : 10,
	});
}

/**
 * 获取${entity}详情
 * @param id 记录ID
 * @returns Promise<ApiResponse>
 */
export async function get${entity}Detail(id: number): Promise<ResponseBody<${entity}Data>> {
	const url = baseService.${javaPath} + base${entity} + ${entity}Endpoints.detail;
	return getData(url, { id });
}

/**
 * 删除${entity}记录
 * @param ids 要删除的记录ID，支持单个ID或逗号分隔的多个ID
 * @returns Promise<ApiResponse>
 */
export async function delete${entity}(ids: string | number | (string | number)[]): Promise<ResponseBody<boolean>> {
	const url = baseService.${javaPath} + base${entity} + ${entity}Endpoints.delete;
	return deleteData(url, { ids });
}

/**
 * 创建${entity}记录
 * @param params 请求参数
 * @returns ResponseBody<${entity}Data>
 */
export async function add${entity}(
	params: ${entity}Data,
): Promise<ResponseBody<${entity}Data>> {
	return postData(
		baseService.${javaPath} + baseCouponInfo + ${entity}Endpoints.create,
		params,
	);
}

export async function edit${entity}(
	params: ${entity}Data,
): Promise<ResponseBody<${entity}Data>> {
	return putData(
		baseService.${javaPath} + baseCouponInfo + ${entity}Endpoints.update,
		params,
	);
}
