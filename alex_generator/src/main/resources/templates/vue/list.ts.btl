import type { TableColumnsType } from 'ant-design-vue';

<% for(field in table.fields) {
 if(field.propertyType == 'LocalDateTime' || field.propertyType == 'LocalDate'){ %>
import type {  Dayjs } from 'dayjs';
<%  break;}
 } %>

export const columns = ref<TableColumnsType>([
<% for(field in table.fields){
    if(field.keyFlag) {
        continue;
    }
%>
	{
  <% if (strutil.contain(field.comment, '字典')) { %>
		title: '${strutil.subStringTo(field.comment, 0, strutil.index(field.comment, '字典') - 1)}',
  <% } else { %>
		title: '${field.comment}',
  <% } %>
		dataIndex: '${field.propertyName}',
		key: '${field.propertyName}',
	},
<% } %>
	{
		title: '操作',
		key: 'operation',
		fixed: 'right',
		width: '8',
	},
]);

export interface ${entity}Data {
    id?: number;
<% for(field in table.fields){
    if(field.propertyType == 'Long' || field.propertyType == 'Integer' || field.propertyType == 'BigDecimal'){ %>
	${field.propertyName}?: number;
    <% } else if (field.propertyType == 'LocalDateTime') { %>
	${field.propertyName}?: Dayjs | string;
    <% } else { %>
	${field.propertyName}?: ${strutil.toLowerCase(strutil.subStringTo(field.propertyType, 0, 1)) + strutil.subString (field.propertyType, 1)};
    <% }
} %>
}

export const labelCol = ref({ span: 5 });
export const wrapperCol = ref({ span: 19 });

export const labelMap = ref<Record<string, { name: string; label: string }>>({
    <% for(field in table.fields){
        if (strutil.contain(field.comment, '字典')) { %>
	${field.propertyName}: { name: '${field.propertyName}', label: '${strutil.subStringTo(field.comment, 0, strutil.index(field.comment, '字典') - 1)}'},
        <% } else { %>
	${field.propertyName}: { name: '${field.propertyName}', label: '${field.comment}'},
        <% }
} %>
});