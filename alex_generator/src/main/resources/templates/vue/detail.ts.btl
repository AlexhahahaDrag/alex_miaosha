import type { Rule } from 'ant-design-vue/es/form/interface';

export const rulesRef: Record<string, Rule[]> = {
<% for(field in table.fields){
       if(field.keyFlag) {
            continue;
       }
  %>
	${field.propertyName}: [
		{
			required: true,
  <% if (strutil.contain(field.comment, '字典')) { %>
			message: '${strutil.subStringTo(field.comment, 0, strutil.index(field.comment, '字典') - 1)}不能为空！',
  <% } else { %>
			message: '${field.comment}不能为空！',
  <% } %>
		},
	],
<% } %>
};

export const labelCol = ref<{ span: number }>({ span: 5 });
export const wrapperCol = ref<{ span: number }>({ span: 19 });